# Installed by `./run.sh brew` (brew bundle). Everything here is in homebrew/core or a cask.

# Shell + editor
brew "fnm"
brew "neovim"
brew "ripgrep"
brew "fzf"           # herdr find plugin
brew "jq"            # herdr find plugin (macOS also ships /usr/bin/jq)

# Dev tools
brew "gh"
brew "go"
brew "bun"
brew "mkcert"
brew "nss"           # lets mkcert install its CA into Firefox

# Terminal
brew "herdr"
cask "ghostty"

# Cloud
cask "gcloud-cli"    # formerly google-cloud-sdk

# Pick one container runtime:
# cask "docker-desktop"
# cask "orbstack"

# Not here on purpose:
# - pnpm: after fnm installs Node, run `corepack enable pnpm`.
# - lwp-request (the GET/POST aliases): ships with macOS.
