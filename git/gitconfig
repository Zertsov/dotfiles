# Symlinked to ~/.gitconfig by run.sh.
# Machine- or work-specific settings go in ~/.gitconfig.local (included last).
[user]
	name = Mitchel Vostrez
	email = mitch@voz.dev
[push]
	autoSetupRemote = true
	useForceIfIncludes = true
[pull]
	ff = only
[core]
	excludesFile = ~/.gitignore_global
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
